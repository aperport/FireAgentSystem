# ============================================================
# GraphRAG 模块配置项
# ============================================================
# 使用说明：填入实际值后，确保 dotenv 能加载本文件
# ============================================================

# ---------- Neo4j 图数据库 ----------
# 来源：graph_traverser.py / graph_db/connection.py
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---------- PostgreSQL + pgvector 向量数据库 ----------
# 来源：collections.py / db_operator.py / orchestrator.py
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DBNAME=fire_rag

# ---------- LLM（DeepSeek）----------
# 来源：agent/llm_config.py → GraphRAG 全链路调用（实体抽取 / LLM查询生成 / 回答生成 / RAGAS评估）
DEEPSEEKAPI=
DEEPSEEKURL=https://api.deepseek.com/v1
DEEPSEEKMODEL=deepseek-chat
DEEPSEEKMODELFAST=deepseek-chat

# ---------- DashScope Embedding（阿里云）----------
# 来源：config.py / embedding.py（文本 text-embedding-v4 + 多模态 multimodal-embedding-v1）
DASHSCOPE_API_KEY=

# ---------- DotsOCR 文档解析服务 ----------
# 来源：config.py / ingestion/doc_parser/image_parser.py / pdf_parser.py
DOTS_OCR_URL=http://localhost:6006

# ---------- Java 后端 REST API ----------
# 来源：ingestion/biz_sync.py（业务数据同步到 Neo4j）
JAVA_API_BASE_URL=http://127.0.0.1:8000

# ---------- HuggingFace 本地 Embedding 模型 ----------
# 来源：collections.py / evaluator.py（PGVectorManager 和 RAGAS 评估使用的本地 Embedding）
# 默认值：BAAI/bge-small-zh-v1.5，512维
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5

# ---------- NER 实体抽取小模型 ----------
# 来源：entity_extractor.py（本地 BERT NER 模型，用于 LLM 实体抽取的兜底）
# 默认值：Davlan/bert-base-multilingual-cased-ner-hrl
ENTITY_EXTRACT_MODEL=Davlan/bert-base-multilingual-cased-ner-hrl

# ---------- Milvus 向量数据库（预留）----------
# 来源：config.py / embedding.py docstring 中提及，当前代码已切换为 PG + pgvector
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
