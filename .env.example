# ============================================================
# 消防后勤智能助手 — 环境变量模板
# ============================================================
# 使用说明：复制本文件为 .env，填入实际值
#   cp .env.example .env
# ============================================================

# ---------- LLM（DeepSeek）----------
DEEPSEEKAPI=your_deepseek_api_key
DEEPSEEKURL=https://api.deepseek.com/v1
DEEPSEEKMODEL=deepseek-chat
DEEPSEEKMODELFAST=deepseek-chat

# ---------- GraphRAG ----------
# Neo4j 图数据库
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Milvus 向量数据库
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# DashScope Embedding（阿里云）
DASHSCOPE_API_KEY=your_dashscope_api_key

# DotsOCR 文档解析服务
DOTS_OCR_URL=http://localhost:6006

# ---------- 后端服务 ----------
# Java 后端 REST API
JAVA_API_BASE_URL=http://127.0.0.1:8000

# MCP Server
MCP_SERVER_URL=http://127.0.0.1:9000/mcp

# MongoDB（Agent Checkpoint 持久化）
MONGODB_URI=mongodb://root:123456@localhost:27017/?authSource=admin

# ---------- 运行环境 ----------
APP_ENV=development
